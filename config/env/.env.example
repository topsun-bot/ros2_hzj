# ros2_hzj 双链环境变量示例（R1）。
# 复制为 .env 后由操作员自己 source / direnv；本仓代码不会自动加载本文件。
# 一次只启用一条链。混用域 42 与域 0 会导致发现失败。

# ---- 链 A：nav FastDDS（取消注释并 source）----
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# ROS_DOMAIN_ID=42
# FASTRTPS_DEFAULT_PROFILES_FILE=  # 由 chain_a.sh 填成 config/fastdds.xml 的绝对路径

# ---- 链 B：DimOS Cyclone / 域 0（取消注释并 source）----
# RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# ROS_DOMAIN_ID=0
# CYCLONEDDS_HOME=                 # 可选；见 docs/usage/transports/dds.md
# CYCLONEDDS_URI=                  # 本仓不提供现网 URI；默认留空
