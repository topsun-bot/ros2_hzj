<!--
  LABELED EXAMPLE — Autoware-like CycloneDDS recipe for Chain B experiments.

  NOT the Chain B default. NOT a SCOREBOARD / nav / Unitree / DimOS profile.
  config/env/chain_b.sh does NOT set CYCLONEDDS_URI. Do not copy this into
  DimOS defaults. Do not point Chain A FASTRTPS_DEFAULT_PROFILES_FILE here.

  Source (verified 2026-09-12):
    https://autowarefoundation.github.io/autoware-documentation/main/installation/additional-settings-for-developers/network-configuration/dds-settings/
    markdown twin:
    https://raw.githubusercontent.com/autowarefoundation/autoware-documentation/main/docs/installation/additional-settings-for-developers/network-configuration/dds-settings.md

  Documented knobs copied from that page:
    MaxMessageSize 65500B
    ParticipantIndex none
    SocketReceiveBufferSize min 10MB
    WhcHigh 500kB
    NetworkInterface name="lo"  (their localhost-oriented sample)

  Domain Id="any" is Autoware's sample. This repo's Chain B contract is
  domain 0 via ROS_DOMAIN_ID / DDSConfig.domain_id — this file does not
  change that. Operator must explicitly:

    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
    export ROS_DOMAIN_ID=0
    export CYCLONEDDS_URI=file:///absolute/path/to/this/file

  See docs/architecture/cn-jp-ros2-absorb.md. Not Feishu field proof.
  不是飞书现场 / 实机 / 跨机根因证明。
-->
<CycloneDDS xmlns="https://cdds.io/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="false" name="lo" priority="default" multicast="default" />
      </Interfaces>
      <AllowMulticast>default</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Discovery>
      <ParticipantIndex>none</ParticipantIndex>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
      <Watermarks>
        <WhcHigh>500kB</WhcHigh>
      </Watermarks>
    </Internal>
  </Domain>
</CycloneDDS>
